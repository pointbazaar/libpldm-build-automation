From: libpldm portable build maintainers
Subject: [PATCH 3/3] tools: Install pd and use portable diagnostics

Developed against upstream be4f63e36408921e76d868593176377de84e945e.

Install the upstream offline package dumper. Replace err/warnx and the
glibc-specific strerrorname_np with ISO C diagnostics and return an exit
status from main. Include byteorder explicitly and set Windows stdin to
binary mode so CR/LF and the text-mode EOF byte do not corrupt packages.
diff --git a/tools/meson.build b/tools/meson.build
index 03b0ec0..fa6a978 100644
--- a/tools/meson.build
+++ b/tools/meson.build
@@ -1,3 +1,3 @@
 if get_option('abi').contains('testing') and get_option('tools').contains('pd')
-    executable('pd', 'pd.c', dependencies: [libpldm_dep])
+    executable('pd', 'pd.c', dependencies: [libpldm_dep], install: true)
 endif
diff --git a/tools/pd.c b/tools/pd.c
index edafe38..a0928c6 100644
--- a/tools/pd.c
+++ b/tools/pd.c
@@ -7,13 +7,18 @@
  */
 
 #include <assert.h>
-#include <err.h>
 #include <inttypes.h>
+#include <libpldm/byteorder.h>
 #include <libpldm/firmware_update.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
+#ifdef _WIN32
+#include <fcntl.h>
+#include <io.h>
+#endif
+
 #define PD_PACKAGE_BUFFER (1ul * 1024ul * 1024ul)
 
 static void pd_print_bytes(const char *head, const void *_buf, size_t len,
@@ -113,17 +118,24 @@ int main(void)
 	int rc;
 
 	status = EXIT_SUCCESS;
+#ifdef _WIN32
+	if (_setmode(_fileno(stdin), _O_BINARY) == -1) {
+		perror("stdin binary mode");
+		return EXIT_FAILURE;
+	}
+#endif
 	package = calloc(PD_PACKAGE_BUFFER, 1);
 	if (!package) {
-		err(EXIT_FAILURE, "malloc");
+		perror("calloc");
+		return EXIT_FAILURE;
 	}
 
 	in = fread(package, 1, PD_PACKAGE_BUFFER, stdin);
 	rc = decode_pldm_firmware_update_package(package, in, &pin, &hdr, &pkg,
 						 0);
 	if (rc < 0) {
-		warnx("Failed to parse PLDM package: %s\n",
-		      strerrorname_np(-rc));
+		fprintf(stderr, "Failed to parse PLDM package: %s\n",
+			strerror(-rc));
 		status = EXIT_FAILURE;
 		goto cleanup_package;
 	}
@@ -158,16 +170,18 @@ int main(void)
 			pd_print_descriptor("\t\t", &desc, "\n");
 		}
 		if (rc) {
-			warnx("Failed parsing firmware device ID record descriptors: %s\n",
-			      strerrorname_np(-rc));
+			fprintf(stderr,
+				"Failed parsing firmware device ID record descriptors: %s\n",
+				strerror(-rc));
 			status = EXIT_FAILURE;
 			goto cleanup_package;
 		}
 		fwrite("\n", 1, 1, stdout);
 	}
 	if (rc) {
-		warnx("Failed parsing firmware device ID records: %s\n",
-		      strerrorname_np(-rc));
+		fprintf(stderr,
+			"Failed parsing firmware device ID records: %s\n",
+			strerror(-rc));
 		status = EXIT_FAILURE;
 		goto cleanup_package;
 	}
@@ -195,16 +209,18 @@ int main(void)
 			pd_print_descriptor("\t\t", &desc, "\n");
 		}
 		if (rc) {
-			warnx("Failed parsing downstream device ID record descriptors: %s\n",
-			      strerrorname_np(-rc));
+			fprintf(stderr,
+				"Failed parsing downstream device ID record descriptors: %s\n",
+				strerror(-rc));
 			status = EXIT_FAILURE;
 			goto cleanup_package;
 		}
 		fwrite("\n", 1, 1, stdout);
 	}
 	if (rc) {
-		warnx("Failed parsing downstream device ID records: %s\n",
-		      strerrorname_np(-rc));
+		fprintf(stderr,
+			"Failed parsing downstream device ID records: %s\n",
+			strerror(-rc));
 		status = EXIT_FAILURE;
 		goto cleanup_package;
 	}
@@ -231,8 +247,9 @@ int main(void)
 		fwrite("\n", 1, 1, stdout);
 	}
 	if (rc) {
-		warnx("Failed parsing component image information: %s\n",
-		      strerrorname_np(-rc));
+		fprintf(stderr,
+			"Failed parsing component image information: %s\n",
+			strerror(-rc));
 		status = EXIT_FAILURE;
 		goto cleanup_package;
 	}
@@ -240,5 +257,5 @@ int main(void)
 cleanup_package:
 	free(package);
 
-	exit(status);
+	return status;
 }
