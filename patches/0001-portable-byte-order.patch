 #else
+#if defined(__APPLE__) || defined(_WIN32)
+#include <libpldm/portable-endian.h>
+#else
+#include <endian.h>
 #include <asm/byteorder.h>
+#endif
 
 #define HTOLE32(X) ((X) = htole32(X))
 #define HTOLE16(X) ((X) = htole16(X))
