From: libpldm portable build maintainers
Subject: [PATCH 4/4] environ: Provide UTF-16 types without Darwin uchar.h

Developed against upstream be4f63e36408921e76d868593176377de84e945e,
after patches 1-3 in this series.

The Xcode 16.4 macOS SDK does not supply uchar.h. The library only uses
char16_t, not the multibyte conversion functions declared by that header.
Use Clang's underlying UTF-16 character type in Darwin C and the native
keyword in C++. Keep the standard uchar.h definition on other C targets.
Install the header so external consumers receive the same type definition.

diff --git a/include/libpldm/char16.h b/include/libpldm/char16.h
new file mode 100644
--- /dev/null
+++ b/include/libpldm/char16.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later */
+#pragma once
+
+/* C++ has a native char16_t keyword. Darwin C lacks <uchar.h>, but Clang
+ * exposes the type used by its UTF-16 string literals.
+ */
+#ifndef __cplusplus
+#ifdef __APPLE__
+typedef __CHAR16_TYPE__ char16_t;
+#else
+#include <uchar.h>
+#endif
+#endif
diff --git a/include/libpldm/meson.build b/include/libpldm/meson.build
--- a/include/libpldm/meson.build
+++ b/include/libpldm/meson.build
@@ -5,6 +5,7 @@ libpldm_headers = files(
     'bios_table.h',
     'byteorder.h',
     'portable-endian.h',
+    'char16.h',
     'compiler.h',
     'control.h',
     'edac.h',
diff --git a/include/libpldm/platform.h b/include/libpldm/platform.h
--- a/include/libpldm/platform.h
+++ b/include/libpldm/platform.h
@@ -9,7 +9,7 @@ extern "C" {
 #include <stdalign.h>
 #include <stddef.h>
 #include <stdint.h>
-#include <uchar.h>
+#include <libpldm/char16.h>
 
 #include <libpldm/api.h>
 #include <libpldm/base.h>
diff --git a/src/msgbuf/core.h b/src/msgbuf/core.h
--- a/src/msgbuf/core.h
+++ b/src/msgbuf/core.h
@@ -49,7 +49,7 @@
 #include <stddef.h>
 #include <stdint.h>
 #include <string.h>
-#include <uchar.h>
+#include <libpldm/char16.h>
 
 /*
  * We can't use static_assert() outside of some other C construct. Deal
diff --git a/src/dsp/platform.c b/src/dsp/platform.c
--- a/src/dsp/platform.c
+++ b/src/dsp/platform.c
@@ -13,7 +13,7 @@
 #include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
-#include <uchar.h>
+#include <libpldm/char16.h>
 
